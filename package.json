{
  "name": "job-tracker-lan",
  "productName": "Job Tracker",
  "version": "1.0.0",
  "description": "LAN-based shared job application tracker (Electron host/client desktop app).",
  "main": "./out/main/index.js",
  "author": "Job Tracker",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs run",
    "test:watch": "node scripts/run-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "survey": "node scripts/run-tests.mjs --survey",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "make-icon": "node scripts/make-icon.mjs",
    "e2e": "node tests/live/e2e-app.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ipaddr.js": "^2.5.0",
    "pino": "^10.0.0",
    "playwright-core": "^1.64.1",
    "selfsigned": "^5.5.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
