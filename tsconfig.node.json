{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "composite": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@server/*": ["src/server/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/server/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "vitest.survey.config.ts"
  ]
}
